module Counter {
    // The invariant bounds the state: a counter can never go negative.
    invariant Counter {
        value >= 0
    }

    // Increment a counter by `by`. A clean mutator: it writes `value`, so the
    // verifier proves a struct-field write and nexus derives the `ReadWrite`
    // right for it.
    func increment(c: Counter, by: PositiveInt)
        requires c.value >= 0
        ensures c.value == old(c.value) + by
    {
        mutate state {
            c.value += by
        }
    }
}
